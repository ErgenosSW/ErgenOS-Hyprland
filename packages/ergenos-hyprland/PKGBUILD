build() {
    rsvg-convert --output wallpaper.png wallpaper.svg
}
check() {
    local script
    for script in notification-session-check ergenos-hyprland-session session-services ergenos-hyprland-menu ergenos-hyprland-screenshot; do
        bash -n "$script"
    done
    python -c 'import json,jsonschema; jsonschema.validate(json.load(open("notifications.json")), json.load(open("/etc/xdg/swaync/configSchema.json")))'
    luac -p hyprland.lua
    foot --check-config --config "$srcdir/foot.ini"
    fuzzel --check-config --config "$srcdir/fuzzel.ini"
    desktop-file-validate ergenos-hyprland.desktop
    XDG_CONFIG_HOME="$srcdir/verify-home" Hyprland --verify-config --config "$srcdir/hyprland.lua"
    python -m py_compile ergenos-hyprland-exit ergenos-hyprland-clipboard desktop-controls.py display-settings.py autostart-settings.py power_config.py power-manager.py power-settings.py window-safety.py
    python test_session.py
    python test_integration.py
    python test_power.py
    python test_clipboard.py
    python test_exit.py
    python test_window_safety.py
    python test_notifications.py
}
package() {
    local file
    install -Dm644 THIRD_PARTY.md "$pkgdir/usr/share/doc/ergenos-hyprland/THIRD_PARTY.md"
    install -Dm755 notification-session-check "$pkgdir/usr/lib/ergenos-hyprland/notification-session-check"
    install -Dm644 swaync-session.conf "$pkgdir/usr/lib/systemd/user/swaync.service.d/ergenos-session.conf"
    for file in hyprland.lua fuzzel.ini notifications.json notifications.css foot.ini hypridle.conf hyprlock.conf waybar.json waybar.css wallpaper.png logo.png desktop-controls.py display-settings.py autostart-settings.py power_config.py power-manager.py power-settings.py window-safety.py battery-*.svg; do
        install -Dm644 "$file" "$pkgdir/usr/share/ergenos-hyprland/$file"
    done
    for file in ergenos-hyprland-session ergenos-hyprland-menu ergenos-hyprland-screenshot ergenos-hyprland-clipboard ergenos-hyprland-exit; do
        install -Dm755 "$file" "$pkgdir/usr/bin/$file"
    done
    for file in panel-bell.svg panel-bell-pending.svg panel-bell-dnd.svg panel-bell-dnd-pending.svg panel-battery-charging.svg panel-battery-low.svg panel-battery.svg panel-bluetooth-off.svg panel-bluetooth.svg panel-brightness.svg panel-ethernet.svg panel-more.svg panel-power.svg panel-volume-low.svg panel-volume-muted.svg panel-volume.svg panel-wifi-off.svg panel-wifi.svg; do
        install -Dm644 "$file" "$pkgdir/usr/share/ergenos-hyprland/icons/${file#panel-}"
    done
    install -Dm644 ergenos-hyprland-session.target "$pkgdir/usr/lib/systemd/user/ergenos-hyprland-session.target"
    install -Dm755 session-services "$pkgdir/usr/lib/ergenos-hyprland/session-services"
    install -Dm644 hyprland-mimeapps.list "$pkgdir/usr/share/applications/hyprland-mimeapps.list"
    install -Dm644 ergenos-hyprland.desktop "$pkgdir/usr/share/wayland-sessions/ergenos-hyprland.desktop"
    install -Dm644 shortcuts.txt "$pkgdir/usr/share/doc/ergenos-hyprland/shortcuts.txt"
    install -Dm644 RELEASE-CHECKLIST.md "$pkgdir/usr/share/doc/ergenos-hyprland/RELEASE-CHECKLIST.md"
    install -Dm644 AUDIT.md "$pkgdir/usr/share/doc/ergenos-hyprland/AUDIT.md"
    install -Dm644 README.md "$pkgdir/usr/share/doc/ergenos-hyprland/README.md"
}
